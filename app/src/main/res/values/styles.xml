<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ScrollLock" parent="android:Widget" />

    <style name="Widget.ScrollLock.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">@dimen/space_lg</item>
        <item name="android:paddingRight">@dimen/space_lg</item>
    </style>

    <style name="Widget.ScrollLock.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/accent_on</item>
    </style>

    <style name="Widget.ScrollLock.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_secondary_fg</item>
    </style>

    <style name="Widget.ScrollLock.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Text.ScrollLock" parent="@android:style/TextAppearance" />

    <style name="Text.ScrollLock.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.ScrollLock.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.ScrollLock.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Text.ScrollLock.Banner">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
