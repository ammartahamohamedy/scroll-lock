<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScrollLock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Do not set android:buttonStyle globally — AlertDialog buttons inherit it
             and end up with white text on a light dialog background. -->
        <item name="android:alertDialogTheme">@style/Theme.ScrollLock.Dialog</item>
    </style>

    <style name="Theme.ScrollLock.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.ScrollLock.DialogButton</item>
    </style>

    <style name="Widget.ScrollLock.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>
</resources>
